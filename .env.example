# ── Supabase (browser-safe) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Expo mobile (mirror of the above)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# ── Server-only (NEVER expose to the client) ──────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Platform superadmins: comma-separated emails allowed into /superadmin to comp
# any company with a full-access free pass. Above per-company tenancy; leave blank
# to disable the surface entirely.
NEXIS_SUPERADMIN_EMAILS=

# ── Google Cloud (Stage 4+) ───────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
CLOUD_TASKS_QUEUE=nexis-payroll
# Private Cloud Run worker URL (deployed --no-allow-unauthenticated in prod).
PAYROLL_WORKER_URL=
# Service account (email) with run.invoker on the worker; Cloud Tasks impersonates
# it to mint the OIDC id-token. Leave blank locally to use the direct-POST dev path.
PAYROLL_WORKER_INVOKER_SA=
# Legacy/dev-only bearer for the direct-POST path; NOT used on the Cloud Tasks path.
PAYROLL_WORKER_TOKEN=
CLOUD_STORAGE_BUCKET_PAYSLIPS=
PAYSLIP_SIGNING_KEY=

# ── Email (transactional) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Nexis <onboarding@resend.dev>

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
